#Def playerchecker(ply_input)
def playerchecker(options):
    #Check if the players input is good
    works = True
    while works:
        ply_input = input("Enter here:")
        works = False
        if ply_input.isnumeric() == True:
            works = True
        if options != 0:
            if ply_input < options:
                works = True
    return ply_input    
            

    
